{
  "manifest_version": 3,
  "name": "AceAttorTWExtension",
  "version": "0.1.1",
  "minimum_chrome_version": "116",
  "description": "Turn X / Twitter threads into animated Ace Attorney courtroom videos with Objection! effects. Free, no AI, rendered on your device.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "branding/icon-16.png", "32": "branding/icon-32.png", "48": "branding/icon-48.png", "128": "branding/icon-128.png" },
  "action": {
    "default_popup": "popup.html", "default_title": "AceAttorTWExtension",
    "default_icon": { "16": "branding/icon-16.png", "32": "branding/icon-32.png", "48": "branding/icon-48.png", "128": "branding/icon-128.png" }
  },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["branding/icon-32.png"],
    "matches": ["https://x.com/*", "https://twitter.com/*"]
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
