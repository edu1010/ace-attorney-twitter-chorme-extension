{
  "manifest_version": 3,
  "name": "AceAttorTWExtension",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Turn visible X conversations into locally rendered Ace Attorney courtroom videos.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "AceAttorTWExtension" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
